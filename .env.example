# Скопируйте в .env и заполните. .env не попадает в git.
# В этот файл НЕ вписывайте настоящие значения — он публикуется в репозитории.

# --- Google Таблица ---
SPREADSHEET_ID=
# путь к JSON-ключу сервисного аккаунта (локально) …
GOOGLE_SERVICE_ACCOUNT_FILE=./google-key.json
# … или весь JSON одной строкой (так делается в GitHub Secrets)
# GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Почта ---
IMAP_HOST=imap.gmail.com
IMAP_USER=
# пароль приложения Google, НЕ обычный пароль от почты
IMAP_PASSWORD=
# сколько дней писем разобрать при первом запуске
EMAIL_FIRST_RUN_DAYS=14

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# свой адрес Bot API (прокси), если api.telegram.org недоступен из сети
# TELEGRAM_API_URL=
# узнать: напишите боту любое сообщение и запустите npm run sync — бот пришлёт ваш ID
TELEGRAM_OWNER_ID=

# --- Остальное ---
TZ_NAME=Asia/Yekaterinburg
DIGEST_HOUR=9
# варианты сопроводительного письма для A/B-сравнения (кнопки в боте)
LETTER_VARIANTS=real-time,legacy,общее
# помечать отклики без ответа >10 дней статусом «Без ответа (>10 дней)»
AUTO_STALE=true
DASHBOARD_URL=
